---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemSolution from '../components/sections/ProblemSolution.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Benefits from '../components/sections/Benefits.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';
---

<Layout>
	{site.analyticsSrc && <script slot="head" defer src={site.analyticsSrc}></script>}
	<Header />
	<main id="main">
		<Hero />
		<ProblemSolution />
		<Features />
		<HowItWorks />
		<Benefits />
		<Contact />
	</main>
	<Footer />
</Layout>
