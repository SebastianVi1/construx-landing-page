---
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale).metrics;
---

<section data-metrics aria-label={t.eyebrow} class="border-y border-blueprint-400/10 bg-ink-900/40">
	<div class="mx-auto max-w-6xl px-5 py-14">
		<p class="text-center font-mono text-xs tracking-[0.2em] text-safety-400 uppercase">{t.eyebrow}</p>
		<div class="mt-10 grid grid-cols-2 gap-y-10 md:grid-cols-4">
			{
				t.items.map((m) => (
					<div data-reveal class="relative px-6 text-center md:border-l md:border-blueprint-400/10 md:first:border-l-0">
						<span aria-hidden="true" class="mx-auto flex h-2.5 w-8 items-center">
							<span class="h-full w-px bg-safety-500/60"></span>
							<span class="mx-1 h-px flex-1 bg-safety-500/60"></span>
							<span class="h-full w-px bg-safety-500/60"></span>
						</span>
						<p class="mt-4 font-mono text-4xl font-semibold tabular-nums text-paper sm:text-5xl">
							<span data-count={m.value}>{m.value}</span>
						</p>
						<p class="mt-2 text-sm font-medium text-paper">{m.label}</p>
						<p class="mt-1 text-xs text-paper-dim">{m.detail}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
