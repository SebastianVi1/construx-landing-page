---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { navLinks, cta } from '../../data/site';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-blueprint-400/10 bg-ink-950/80 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
		<a href="#top" aria-label="Construx home"><Logo /></a>

		<nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
			{
				navLinks.map((link) => (
					<a href={link.href} class="text-sm text-paper-dim transition-colors hover:text-paper">
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3">
			<Button href={cta.primary.href} class="!py-2 max-sm:hidden">{cta.primary.label}</Button>
			<button
				id="menu-toggle"
				type="button"
				class="inline-flex size-10 items-center justify-center rounded-md border border-blueprint-400/30 md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu"
			>
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<nav id="mobile-menu" aria-label="Mobile" hidden class="border-t border-blueprint-400/10 bg-ink-950 md:hidden">
		<ul class="mx-auto flex max-w-6xl flex-col px-5 py-3">
			{
				navLinks.map((link) => (
					<li>
						<a href={link.href} class="block py-3 text-paper-dim hover:text-paper">
							{link.label}
						</a>
					</li>
				))
			}
			<li class="py-3">
				<Button href={cta.primary.href} class="w-full">{cta.primary.label}</Button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	function setOpen(open: boolean) {
		if (!toggle || !menu) return;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		menu.hidden = !open;
	}

	toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
	menu?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setOpen(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			setOpen(false);
			toggle?.focus();
		}
	});
</script>
