---
import SectionHeading from '../ui/SectionHeading.astro';
import { steps } from '../../data/content';
---

<section id="how-it-works" aria-labelledby="how-title" class="py-24">
	<div class="mx-auto max-w-6xl px-5">
		<SectionHeading
			id="how-title"
			eyebrow="How it works"
			title="From company workspace to full site visibility in five steps."
		/>
		<ol class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-4">
			<div
				data-steps-line
				class="absolute top-5 right-[10%] left-[10%] hidden h-px origin-left bg-safety-500/60 md:block"
				aria-hidden="true"
			>
			</div>
			{
				steps.map((s, i) => (
					<li data-reveal class="relative flex gap-4 md:flex-col md:gap-0">
						<span class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full border border-safety-500 bg-ink-950 font-mono text-sm text-safety-400">
							{i + 1}
						</span>
						<div class="md:mt-5">
							<h3 class="text-lg font-bold">{s.title}</h3>
							<p class="mt-1 text-sm text-paper-dim">{s.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
