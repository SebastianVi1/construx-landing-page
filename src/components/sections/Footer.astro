---
import Logo from '../ui/Logo.astro';
import { navLinks, site } from '../../data/site';
---

<footer class="border-t border-blueprint-400/10 bg-ink-950">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-start md:justify-between">
		<div class="max-w-xs">
			<Logo />
			<p class="mt-4 text-sm text-paper-dim">
				One platform to coordinate projects, workforce, and operations across every construction site.
			</p>
		</div>
		<nav aria-label="Footer">
			<ul class="flex flex-wrap gap-x-8 gap-y-3">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="text-sm text-paper-dim hover:text-paper">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<div class="border-t border-blueprint-400/10 py-6 text-center text-xs text-paper-dim">
		&copy; {site.year} {site.name}. All rights reserved.
	</div>
</footer>
