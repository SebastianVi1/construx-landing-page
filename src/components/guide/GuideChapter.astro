---
import DashboardMockup from '../mockups/DashboardMockup.astro';
import TaskBoardMockup from '../mockups/TaskBoardMockup.astro';
import PlanMockup from '../mockups/PlanMockup.astro';
import WorkforceMockup from '../mockups/WorkforceMockup.astro';
import FinanceMockup from '../mockups/FinanceMockup.astro';
import type { ChapterId, ChapterVisual } from '../../data/guide';
import { useTranslations } from '../../i18n';

interface Props {
	id: ChapterId;
	index: number;
	visual: ChapterVisual;
}
const { id, index, visual } = Astro.props;
const t = useTranslations(Astro.currentLocale).guide;
const copy: { title: string; summary: string; steps: string[]; who: string; tip?: string } = t.chapters[id];

const visuals = {
	dashboard: DashboardMockup,
	tasks: TaskBoardMockup,
	plan: PlanMockup,
	workforce: WorkforceMockup,
	finance: FinanceMockup,
} as const;
const Visual = visual === 'none' ? null : visuals[visual];
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-24 py-14 first:pt-0">
	<div class:list={['grid gap-10', Visual && 'xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] xl:items-start']}>
		<div data-reveal class="min-w-0">
			<p class="font-mono text-xs text-safety-400">{String(index + 1).padStart(2, '0')}</p>
			<h2 id={`${id}-title`} class="mt-2 text-2xl font-bold sm:text-3xl">{copy.title}</h2>
			<p class="mt-3 text-paper-dim">{copy.summary}</p>
			<ol class="mt-6 space-y-4">
				{
					copy.steps.map((step, i) => (
						<li class="flex gap-4">
							<span class="grid size-7 shrink-0 place-items-center rounded-full border border-safety-500/70 font-mono text-xs text-safety-400">
								{i + 1}
							</span>
							<span class="pt-0.5 text-sm text-paper sm:text-base">{step}</span>
						</li>
					))
				}
			</ol>
			<p class="mt-6 text-sm text-paper-dim">
				<span class="mr-2 font-mono text-xs tracking-[0.15em] text-safety-400 uppercase">{t.whoLabel}</span>
				{copy.who}
			</p>
			{
				copy.tip && (
					<p class="mt-4 rounded-md border-l-2 border-safety-500 bg-ink-900/70 px-4 py-3 text-sm text-paper-dim">
						<strong class="font-semibold text-paper">{t.tipLabel}:</strong> {copy.tip}
					</p>
				)
			}
		</div>
		{
			Visual && (
				<div data-reveal class="min-w-0">
					<Visual />
				</div>
			)
		}
	</div>
</section>
