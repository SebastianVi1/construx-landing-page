---
import Layout from '../layouts/Layout.astro';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import Metrics from './sections/Metrics.astro';
import ProblemSolution from './sections/ProblemSolution.astro';
import Features from './sections/Features.astro';
import Modules from './sections/Modules.astro';
import HowItWorks from './sections/HowItWorks.astro';
import Benefits from './sections/Benefits.astro';
import Faq from './sections/Faq.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';
import { site } from '../data/site';
---

<Layout>
	{site.analyticsSrc && <script slot="head" defer src={site.analyticsSrc}></script>}
	<Header />
	<main id="main">
		<Hero />
		<Metrics />
		<ProblemSolution />
		<Features />
		<Modules />
		<HowItWorks />
		<Benefits />
		<Faq />
		<Contact />
	</main>
	<Footer />
</Layout>
