---
import MockupFrame from './MockupFrame.astro';

const columns = [
	{
		title: 'To do',
		tasks: [{ t: 'Order rebar, level 2', who: 'LM', p: 'High' }],
	},
	{
		title: 'In progress',
		tasks: [
			{ t: 'Pour slab, grid C', who: 'JR', p: 'High' },
			{ t: 'Inspect scaffolding', who: 'AK', p: 'Med' },
		],
	},
	{
		title: 'Done',
		tasks: [{ t: 'Survey boundary', who: 'DP', p: 'Low' }],
	},
];
---

<MockupFrame title="Tasks · Harbor Tower (sample)">
	<div class="grid grid-cols-3 gap-2">
		{
			columns.map((c) => (
				<div>
					<p class="mb-2 font-mono text-[10px] tracking-wider text-paper-dim uppercase">{c.title}</p>
					<ul class="space-y-2">
						{c.tasks.map((task) => (
							<li class="rounded-md border border-blueprint-400/15 bg-ink-800 p-2">
								<p class="text-[11px] leading-snug">{task.t}</p>
								<div class="mt-2 flex items-center justify-between">
									<span class="grid size-5 place-items-center rounded-full bg-ink-600 font-mono text-[9px]">{task.who}</span>
									<span
										class:list={[
											'rounded px-1 font-mono text-[9px]',
											task.p === 'High' ? 'bg-safety-500/20 text-safety-400' : 'bg-blueprint-400/15 text-blueprint-300',
										]}
									>
										{task.p}
									</span>
								</div>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</MockupFrame>
