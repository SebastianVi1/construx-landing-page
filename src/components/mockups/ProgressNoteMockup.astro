---
import MockupFrame from './MockupFrame.astro';
import { useTranslations } from '../../i18n';

const m = useTranslations(Astro.currentLocale).mockup.progressNote;
---

<MockupFrame title={m.title}>
	<div class="space-y-3">
		<div class="flex items-center justify-between gap-2">
			<span class="rounded bg-ok/15 px-1.5 py-0.5 font-mono text-[10px] text-ok">{m.status}</span>
			<span class="font-mono text-[10px] text-paper-dim">{m.started}</span>
		</div>
		<p class="font-mono text-[10px] tracking-wider text-paper-dim uppercase">{m.history}</p>
		<article class="rounded-md border border-blueprint-400/15 bg-ink-800 p-3">
			<div class="flex items-center justify-between gap-2">
				<span class="grid size-5 place-items-center rounded-full bg-ink-600 font-mono text-[9px]">{m.author}</span>
				<span class="rounded bg-safety-500/15 px-1.5 py-0.5 font-mono text-[9px] whitespace-nowrap text-safety-400">{m.source}</span>
			</div>
			<p class="mt-2 text-[11px] leading-snug">{m.text}</p>
			<div class="mt-3 grid grid-cols-2 gap-2" aria-hidden="true">
				<span class="h-14 rounded-md border border-blueprint-400/10 bg-ink-700"></span>
				<span class="h-14 rounded-md border border-blueprint-400/10 bg-ink-700"></span>
			</div>
			<p class="mt-2 font-mono text-[10px] text-paper-dim">{m.meta}</p>
		</article>
	</div>
</MockupFrame>
