---
import MockupFrame from './MockupFrame.astro';

const people = [
	{ name: 'Lucia Moreno', role: 'Site engineer', project: 'Harbor Tower', initials: 'LM' },
	{ name: 'Jorge Ruiz', role: 'Foreman', project: 'Harbor Tower', initials: 'JR' },
	{ name: 'Ana Kim', role: 'Safety officer', project: 'North Depot', initials: 'AK' },
	{ name: 'Diego Paz', role: 'Surveyor', project: 'Riverside Lofts', initials: 'DP' },
];
---

<MockupFrame title="Team (sample)">
	<ul class="divide-y divide-blueprint-400/10">
		{
			people.map((p) => (
				<li class="flex items-center gap-3 py-2.5">
					<span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink-600 font-mono text-[11px]">{p.initials}</span>
					<div class="min-w-0 flex-1">
						<p class="truncate text-xs font-semibold">{p.name}</p>
						<p class="truncate text-[11px] text-paper-dim">{p.role}</p>
					</div>
					<span class="shrink-0 rounded bg-blueprint-400/15 px-1.5 py-0.5 font-mono text-[10px] text-blueprint-300">
						{p.project}
					</span>
				</li>
			))
		}
	</ul>
</MockupFrame>
