---
import MockupFrame from './MockupFrame.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale).mockup.team;

const people = [
	{ name: 'Lucia Moreno', role: t.roles[0], project: 'Harbor Tower', initials: 'LM' },
	{ name: 'Jorge Ruiz', role: t.roles[1], project: 'Harbor Tower', initials: 'JR' },
	{ name: 'Ana Kim', role: t.roles[2], project: 'North Depot', initials: 'AK' },
	{ name: 'Diego Paz', role: t.roles[3], project: 'Riverside Lofts', initials: 'DP' },
];
---

<MockupFrame title={t.title}>
	<ul class="divide-y divide-blueprint-400/10">
		{
			people.map((p) => (
				<li class="flex items-center gap-3 py-2.5">
					<span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink-600 font-mono text-[11px]">{p.initials}</span>
					<div class="min-w-0 flex-1">
						<p class="truncate text-xs font-semibold">{p.name}</p>
						<p class="truncate text-[11px] text-paper-dim">{p.role}</p>
					</div>
					<span class="shrink-0 rounded bg-blueprint-400/15 px-1.5 py-0.5 font-mono text-[10px] text-blueprint-300">
						{p.project}
					</span>
				</li>
			))
		}
	</ul>
</MockupFrame>
