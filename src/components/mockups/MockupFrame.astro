---
import { useTranslations } from '../../i18n';

interface Props {
	title: string;
	class?: string;
}
const { title, class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<figure
	class:list={['overflow-hidden rounded-xl border border-blueprint-400/25 bg-ink-900 shadow-2xl shadow-black/40', className]}
>
	<div class="flex items-center justify-between gap-2 border-b border-blueprint-400/15 bg-ink-800 px-4 py-2.5">
		<div class="flex items-center gap-1.5 max-sm:hidden" aria-hidden="true">
			<span class="size-2.5 rounded-full bg-ink-600"></span>
			<span class="size-2.5 rounded-full bg-ink-600"></span>
			<span class="size-2.5 rounded-full bg-ink-600"></span>
		</div>
		<figcaption class="min-w-0 truncate font-mono text-[11px] tracking-wide text-paper-dim">{title}</figcaption>
		<span class="shrink-0 rounded bg-safety-500/15 px-1.5 py-0.5 font-mono text-[10px] whitespace-nowrap text-safety-400">{t.mockup.demo}</span>
	</div>
	<div class="p-4"><slot /></div>
</figure>
