---
import MockupFrame from './MockupFrame.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale).mockup.crm;

type Stage = 0 | 1 | 2;
const clients: { name: string; contact: string; initials: string; stage: Stage }[] = [
	{ name: 'Delta Properties', contact: 'Marta Solis', initials: 'MS', stage: 2 },
	{ name: 'Marlow Developers', contact: 'Tom Hale', initials: 'TH', stage: 1 },
	{ name: 'Civic Works', contact: 'Priya Rao', initials: 'PR', stage: 1 },
	{ name: 'Bayline Homes', contact: 'Chen Wu', initials: 'CW', stage: 0 },
];
const stageStyle = [
	'bg-blueprint-400/15 text-blueprint-300',
	'bg-safety-500/20 text-safety-400',
	'bg-ok/15 text-ok',
];
---

<MockupFrame title={t.title}>
	<ul class="divide-y divide-blueprint-400/10">
		{
			clients.map((c) => (
				<li class="flex items-center gap-3 py-2.5">
					<span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink-600 font-mono text-[11px]">{c.initials}</span>
					<div class="min-w-0 flex-1">
						<p class="truncate text-xs font-semibold">{c.name}</p>
						<p class="truncate text-[11px] text-paper-dim">{c.contact}</p>
					</div>
					<span class:list={['shrink-0 rounded px-1.5 py-0.5 font-mono text-[10px]', stageStyle[c.stage]]}>
						{t.stages[c.stage]}
					</span>
				</li>
			))
		}
	</ul>
</MockupFrame>
