---
import MockupFrame from './MockupFrame.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale).mockup.plan;

const positions = [
	{ x: 70, y: 62 },
	{ x: 190, y: 62 },
	{ x: 250, y: 130 },
	{ x: 110, y: 135 },
];
const markers = positions.map((pos, i) => ({ ...pos, n: i + 1, label: t.markers[i] }));
---

<MockupFrame title={t.title}>
	<svg viewBox="0 0 320 190" class="w-full" role="img" aria-label={t.alt}>
		<g fill="none" stroke="var(--color-blueprint-400)" stroke-width="1.5" data-draw>
			<rect x="20" y="20" width="280" height="150"></rect>
			<path d="M20 90h120M140 20v150M140 110h160M220 110v60"></path>
			<path d="M60 20v14M180 20v14M260 110v14" stroke-dasharray="3 3" opacity=".6"></path>
		</g>
		<g font-family="var(--font-mono)" font-size="8" fill="var(--color-paper-dim)">
			<text x="28" y="38">{t.zones[0]}</text>
			<text x="148" y="38">{t.zones[1]}</text>
			<text x="148" y="128">{t.zones[2]}</text>
		</g>
		{
			markers.map((m) => (
				<g transform={`translate(${m.x} ${m.y})`}>
					<g data-plan-marker style="transform-box:fill-box;transform-origin:center">
						<circle r="10" fill="var(--color-safety-500)"></circle>
						<text text-anchor="middle" y="4" font-size="11" font-weight="700" fill="var(--color-ink-950)">
							{m.n}
						</text>
					</g>
				</g>
			))
		}
	</svg>
	<ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-[11px] text-paper-dim">
		{
			markers.map((m) => (
				<li>
					<span class="font-mono text-safety-400">{m.n}</span> {m.label}
				</li>
			))
		}
	</ul>
</MockupFrame>
