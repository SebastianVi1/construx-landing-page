---
import MockupFrame from './MockupFrame.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale).mockup.dashboard;

const stats = [
	{ label: t.stats[0], value: '4' },
	{ label: t.stats[1], value: '86' },
	{ label: t.stats[2], value: '137' },
];
const projects = [
	{ name: 'Harbor Tower', site: t.sites[0], progress: 62 },
	{ name: 'Riverside Lofts', site: t.sites[1], progress: 41 },
	{ name: 'North Depot', site: t.sites[2], progress: 88 },
];
---

<MockupFrame title={t.title}>
	<div class="grid grid-cols-3 gap-2 sm:gap-3">
		{
			stats.map((s) => (
				<div class="rounded-lg border border-blueprint-400/15 bg-ink-800 p-3">
					<p class="font-display text-2xl font-bold sm:text-3xl">{s.value}</p>
					<p class="mt-1 text-[11px] text-paper-dim">{s.label}</p>
				</div>
			))
		}
	</div>
	<ul class="mt-3 space-y-2 sm:mt-4 sm:space-y-3">
		{
			projects.map((p) => (
				<li class="rounded-lg border border-blueprint-400/15 bg-ink-800 p-3">
					<div class="flex items-baseline justify-between text-xs">
						<span class="font-semibold">{p.name}</span>
						<span class="font-mono text-paper-dim">{p.site}</span>
					</div>
					<div class="mt-2 h-1.5 overflow-hidden rounded-full bg-ink-600">
						<div data-progress={p.progress} class="h-full origin-left rounded-full bg-safety-500" style={`width:${p.progress}%`} />
					</div>
					<p class="mt-1.5 text-right font-mono text-[10px] text-paper-dim">{p.progress}% {t.complete}</p>
				</li>
			))
		}
	</ul>
</MockupFrame>
