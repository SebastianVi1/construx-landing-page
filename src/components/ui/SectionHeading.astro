---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	id?: string;
}
const { eyebrow, title, description, id } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
	<p class="font-mono text-xs tracking-[0.2em] text-safety-400 uppercase">{eyebrow}</p>
	<h2 id={id} class="mt-3 text-3xl font-bold sm:text-4xl">{title}</h2>
	{description && <p class="mt-4 text-lg text-paper-dim">{description}</p>}
</div>
